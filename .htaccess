# Redirect HTTP → HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://phodar.net/$1 [R=301,L]

# Ако файл или директория съществува – не пипай
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Всичко останало → React index.html (client-side routing)
RewriteRule . /index.html [L]
